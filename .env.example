# Copy to .env and fill in. Never commit .env.

BASE_URL=https://copilot.asksam.com.au
LOGIN_URL=https://copilot.asksam.com.au/sign-in
DASHBOARD_URL=https://dashboard.asksam.com.au
EXPERT_DASHBOARD_URL=https://dashboard.asksam.com.au/expert/dashboard
COPILOT_HOME_URL=https://copilot.asksam.com.au/clinical/home

# Clerk test-mode clinician email (OTP code 424242 in test mode)
TEST_EMAIL=
TEST_PASSWORD=

# Optional: separate email for letter-template module tests
LETTER_TEMPLATE_TEST_EMAIL=

GOOGLE_APPS_SCRIPT_URL=
EMAIL_WEB_APP_URL=
# From address for failure emails (Apps Script must run as this account, or have it as Send-as alias)
REPORT_FROM_EMAIL=saira@shunyalabs.ai
# Comma-separated failure report recipients (To)
REPORT_RECIPIENTS=arti@shunyalabs.ai,sumit@shunyalabs.ai,yamini@shunyalabs.ai,saira@shunyalabs.ai,sb@shunyalabs.ai,ritu@shunyalabs.ai,ravulamk@shunyalabs.ai,saheb@shunyalabs.ai

# Optional
GOOGLE_SHEETS_URL=
DASHBOARD_PAGES_URL=https://shunyalabsai.github.io/asksam-automation/

# RAG API smoke tests (rag.uwc.world) — AskSam v1; keep until formally retired
RAG_API_BASE_URL=https://rag.uwc.world
RAG_API_USER_ID=automation-smoke
RAG_API_SESSION_ID=smoke-session
RAG_API_REGISTERED_ID=automation-smoke
RAG_API_GEN_CHAT_MESSAGE=ping
RAG_API_GEN_CHAT_CLASSIFY=general

# AskSam v2 (asksam.uwc.world) — read-only smokes; no auth yet
ASKSAM_V2_BASE_URL=https://asksam.uwc.world
ASKSAM_V2_API_KEY=
ASKSAM_V2_USER_ID=714823
ASKSAM_V2_SESSION_ID=6adb50e45724764f6fbb1005
ASKSAM_V2_REGISTERED_ID=6adb50e45724764f6fbb1005
ASKSAM_V2_ORGANIZATION_ID=asksam
# Set false to skip TC_V2_10 generate-note-fields (also auto-skips 03:30–11:30 IST)
ASKSAM_V2_INCLUDE_AI=true

# Clinical Notes API — base URL filled by discover:clinical-notes-apis (prod Copilot network capture)
CLINICAL_NOTES_API_BASE_URL=

# Stella / NeoGraph — base URLs filled by discover:assistant-apis
STELLA_API_BASE_URL=
NEOGRAPH_API_BASE_URL=

# ASR — transcribe-from-url-v2 (cauth.unitedwecare.com, Authorization: Bearer)
ASR_API_BASE_URL=https://cauth.unitedwecare.com
ASR_API_KEY=
ASR_AUDIO_URL=https://firebasestorage.googleapis.com/v0/b/united-for-her.appspot.com/o/uploads%2Frecording_1782127426430_644938.webm?alt=media&token=fce69d88-e7ee-45a5-b079-f69183582299
ASR_LANGUAGE=en

# Optional: AU proxy for Stripe geo-restricted signup test
# AU_PROXY_SERVER=
# AU_PROXY_USERNAME=
# AU_PROXY_PASSWORD=
